extends ../layouts/_layout.pug

block title
  title Все страницы - index.pug


block content

  - 
    var heroCategories = [
      {
        'name': 'square-academic-cap',
        'title': 'Оставить заявку',
        'description': 'Заявка на обучение, стажировку или консультацию'
      },
      {
        'name': 'book',
        'title': 'Конференции',
        'description': 'Материалы отраслевых мероприятий о деменции'
      },
      {
        'name': 'sheet-and-pen',
        'title': 'Рекомендации',
        'description': 'Я подозреваю деменцию у себя или у родственника: что делать?'
      },
      {
        'name': 'easel',
        'title': 'Искусство',
        'description': 'Восприятие деменции в литературе, театре и кино'
      },
    ];

    var sources = [
      {
        'title': 'Ключевые источники информации о деменции*',
        'class': 'progress__green',
        'dataProgress': '42',
        'icoName': 'person',
      },
      {
        'title': 'интернет',
        'class': 'progress__light-blue',
        'dataProgress': '30',
        'icoName': 'training',
      },
      {
        'title': 'телевидение',
        'class': 'progress__orange',
        'dataProgress': '24',
        'icoName': 'tv',
      },
      {
        'title': 'литература, кино',
        'class': 'progress__purple',
        'dataProgress': '14',
        'icoName': 'play',
      },
      {
        'title': 'профессиональный опыт и знания',
        'class': 'progress__coral',
        'dataProgress': '13',
        'icoName': 'briefcase2',
      },
    ];


  main
    section.hero
      .container
        .hero__item
          .hero__title
            span.text-accent Деменция.
            span Главное
          .hero__slogan Актуальные знания от специалистов-практиков с 30-летним опытом
        .hero__item.hero__item-picture
          a(href="index.html" class="hero__anchor")
            .hero__circle
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M8 16L2.92357e-07 9.88494L1.46757 8.76127L8 13.7559L14.5304 8.76128L16 9.88494L8 16ZM8 11.2387L5.1999e-07 5.12366L1.46757 4L8 8.99458L14.5304 4L16 5.12208L8 11.2387Z" fill="#35333D"/>
              </svg>
          picture.hero__picture
            img(src='./img/section/hero-img.png' alt="") 
    section.hero-categories
      .container
        .cards.cards__circle-bottom
          - var featured = true
          each el in heroCategories
            a(href="#" class= featured ? 'card card__link featured' : 'card card__link') 
              .card__content 
                .card-top__img 
                  +svgData(el.name)
                .card__title 
                  != el.title
                .card__description.text-center 
                  != el.description
              
              div(class="card__circle")
                +svgDataArrow('topRight')
            - featured = false
    section.info
      .container
        .info__title Поддержка людей с деменцией и их близких — одно из приоритетных направлений работы Благотворительного центра «<a href="#" class="link__red">Хэсэд Авраам</a>» в Санкт-Петербурге
        .info__text.block-max-width-1110.text-center Созданный на его базе в 2023 году Центр знаний о деменции призван консолидировать усилия профессионального сообщества в борьбе с деменцией, координировать обмен знаниями и практическим опытом среди специалистов со всей России, а также популяризировать актуальную информацию о когнитивных нарушениях
        .text-center
          a(href="#" class="btn btn__icon")
            span.btn__text Подробнее
            span.btn__svg
              +svgDataArrow('arrow-right')

    section.info-people
      .info-people__background
      .container
        .cards
          .card.info-people__colleagues
            .content
              .card__title Коллегам
              .card__description в сфере заботы о людях с деменцией
              ul.info-people__list-ico
                li.info-people__list-item
                  a(href="#" class="info-people__list-link link__red")  
                    span.svg
                      +svgDataIco('training')
                    span.text Обучение
                li.info-people__list-item
                  a(href="#" class="info-people__list-link link__red")  
                    span.svg
                      +svgDataIco('briefcase')
                    span.text Стажировка
                li.info-people__list-item
                  a(href="#" class="info-people__list-link link__red") 
                    span.svg
                      +svgDataIco('book-open')
                    span.text База знаний
              .btn__container      
                a(href="#" class="btn__red btn__icon")
                  span.btn__text Узнать больше
                  span.btn__svg
                    +svgDataArrow('arrow-right-white')
            .card__img-last
              picture
                img(src='./img/section/colleagues.png' class="img-adaptive" alt="Коллегам") 
              
          .card.info-people__employees
            .content
              .card__title Сотрудникам
              .card__description банков, МФЦ и других учреждений, которые посещают люди с когнитивными нарушениями
              ul.info-people__list-ico
                li.info-people__list-item  
                  a(href="#" class="info-people__list-link link__red") 
                    span.svg
                      +svgDataIco('message')
                    span.text Руководство по общению
                li.info-people__list-item
                  a(href="#" class="info-people__list-link link__red") 
                    span.svg
                      +svgDataIco('sheet-text')
                    span.text Полезные практики
              .btn__container  
                a(href="#" class="btn__red btn__icon")
                  span.btn__text Узнать больше
                  span.btn__svg
                    +svgDataArrow('arrow-right-white')
            .card__img-last
              picture
                img(src='./img/section/employees.png' class="img-adaptive" alt="Сотрудникам")


          .card.info-people__relatives
            .content
              .card__title Родственникам
              .card__description людей, у которых диагностирована деменция
              ul.info-people__list-ico
                li.info-people__list-item  
                  a(href="#" class="info-people__list-link link__red") 
                    span.svg
                      +svgDataIco('help-bold')
                    span.text Психологическая поддержка
                li.info-people__list-item
                  a(href="#" class="info-people__list-link link__red") 
                    span.svg
                      +svgDataIco('sheet-text2')
                    span.text Путеводитель
              .btn__container  
                a(href="#" class="btn__red btn__icon")
                  span.btn__text Узнать больше
                  span.btn__svg
                    +svgDataArrow('arrow-right-white')
            .card__img-last
                picture
                  img(src='./img/section/relatives.png' class="img-adaptive" alt="Родственникам")
            
    section.front-facts
      .container
        .cards
          .card
            .item.stats
              .front-facts__title
                span.text-accent 10 000 000
                span новых случаев деменции в год регистрируется по всему миру
              .text После 65 лет это патологическое состояние, вызванное поражением головного мозга, затрагивает до 5% людей на планете, а после 80 лет — до 20%
            .item.awareness
              .awareness__title Осведомленность россиян о проблеме деменции*

              picture.awareness__picture.awareness__desktop
                img(src='./img/section/awareness.png' class="img-adaptive" alt="") 
              picture.awareness__picture.awareness__mobile
                img(src='./img/section/awareness-mobile.png' class="img-adaptive" alt="") 
      
          .card.front-facts__sources
            .awareness__title Ключевые источники информации о деменции*
            .item
              each source in sources
                div(class = `progress__box ${source.class}`)
                  .progress__ico
                    +svgDataIco(source.icoName)
                  .progress__bar-text
                    .progress
                      span(class="progress-bar" data-progress=`${source.dataProgress}`)
                    .progress__text 
                      != source.title
            .item.item__last
              .text-center * - по материалам опроса 
                a(href="#" class="link__red") ВЦИОМ
                | , 2023 год

        .text-center
          a(href="#" class="btn btn__icon")
            span.btn__text В базу знаний
            span.btn__svg
              +svgDataArrow('topRight')

    section.front-news 
      .container
        .swiper__container
          .swiper.news__slider
            .swiper-wrapper
              - var i = 0
              while i < 3
                .swiper-slide
                  a(href="#" class="swiper-slide__link")
                    .swiper-slide__img
                      picture
                        img(src='./img/section/front-slider/1.png' alt="") 
                    .swiper-slide__text Ученые Гарварда выяснили, что всего 16 глотков этого напитка в день снизят риск деменции

                .swiper-slide
                  a(href="#" class="swiper-slide__link")
                    .swiper-slide__img
                      picture
                        img(src='./img/section/front-slider/2.png' alt="") 
                    .swiper-slide__text Заболеваемость возрастной деменцией снизилась вдвое       

                .swiper-slide
                  a(href="#" class="swiper-slide__link")
                    .swiper-slide__img
                      picture
                        img(src='./img/section/front-slider/3.png' alt="") 
                    .swiper-slide__text Ученые раскрыли, почему стареющий мозг теряет защиту от деменции

                - i++     

          .swiper-controlling
            .swiper-pagination.news__pagination
            .swiper-arrow
              .news__arrow-prev.swiper-button-prev
              .news__arrow-next.swiper-button-next
            .text Мы собираем ключевые новости, представляющие интерес для специалистов в сфере заботы о людях с деменцией, а также анонсы крупнейших отраслевых мероприятий
            a(href="#" class="btn__gold btn__icon")
              span.btn__text Все новости
              span.btn__svg
                +svgDataArrow('topRight')



    



    h2 Страницы сайта
    ul
      li: a(href="index.html") Главная
      li: a(href="about.html") О нас
      li: a(href="contact.html") Контакты
      li: a(href="example.html") Пример