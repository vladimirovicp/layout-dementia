      },
      {
        idVideo: 'whldazqQHPI',
        img: './img/page/webinards/9.jpg',
        number: '#08',
        title: 'Особенности питания лиц пожилого возраста',
        text: 'Об&nbsp;особенностях работы организма человека в&nbsp;пожилом возрасте и&nbsp;о&nbsp;том, какой вклад правильное питание вносит в&nbsp;реабилитацию людей с&nbsp;деменцией',
        name: 'Иван Викторович Яковлев',
        autorInfo: 'Врач-гериатр, терапевт, врач по гигиене питания'
      }
    ]

  main.page.page__webinards
    +titlePage('Вебинары')
    +breadcrumbs([
      { title: 'Главная', url: 'index.html' },
      { title: 'База знаний', url: 'knowledge-base.html' },
      { title: 'Вебинары', current: true }
    ])

    article.article
      +heroImage('./img/hero-image/webinards.jpg', 'Родственникам')

      .box 
        .container 
          .text-center--d.text-center--d-110 В&nbsp;2021&ndash;2022 годах Благотворительный центр &laquo;<strong>Хэсэд Авраам</strong>&raquo; и&nbsp;Женская еврейская организация <strong>&laquo;Проект Кешер&raquo;</strong> провели цикл вебинаров &laquo;Деменция. Как быть рядом&raquo;, адресованный родственникам людей с&nbsp;деменцией, но&nbsp;представляющий интерес также для социальных работников и&nbsp;специалистов по&nbsp;уходу

      .webinars__list
        .container
          .highlight-background.highlight-background__radius-tb
          .media-pairs 
              each el in videos
                .media-pair 
                  .media-pair__video.video-preview(
                    data-youtube-id=el.idVideo
                    tabindex="0"
                    aria-label="Play video"
                  )
                    .video-preview__inner
                      img(
                        class="video-preview__thumb"
                        src=el.img
                        alt="Video preview"
                        loading="lazy"
                        decoding="async"
                      )
                      button(class="video-preview__play" aria-hidden="false" title="Play video" type="button")
                        img(src="./img/svg/play.svg", alt="")
                  .media-pair__info
                      .media-pair__number 
                        != el.number
                      .media-pair__title
                        != el.title
                      .media-pair__text-2 
                        != el.text
                      .media-pair__autor
                        .media-pair__autor-ico
                          img(
                            src="./img/svg/user-mini.svg", 
                            alt=el.title
                            )
                        .media-pair__autor-container
                            .media-pair__name
                              != el.name
                            .media-pair__autor-info 
                              != el.autorInfo

