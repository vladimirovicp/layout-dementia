extends ../layouts/_layout.pug

block title
  title Конференции

block content

  - 
    var videos = [
      {
        idVideo: 'SbecE1N27hM',
        img: './img/page/webinards/1.jpg',
        number: '#01',
        title: 'Деменция. Взгляд изнутри',
        text: 'О&nbsp;ключевых причинах и&nbsp;признаках деменции, об&nbsp;основных принципах профилактики и&nbsp;лечения когнитивных нарушений',
        name: 'Лидия Ивановна Гузева',
        autorInfo: 'Член Ассоциации неврологов Санкт-Петербурга, ведущий врач-невролог Международного медицинского центра &laquo;Согаз&raquo;'

      },
      {
        idVideo: 'MpNY8vWId6Q',
        img: './img/page/webinards/2.jpg',
        number: '#02',
        title: 'Основы проведения когнитивного тренинга',
        text: 'Об&nbsp;основных принципах построения и&nbsp;проведения занятий по&nbsp;тренировке памяти, внимания и&nbsp;мышления пожилых людей',
        name: 'Наталия Анатольевна Краснопольская',
        autorInfo: 'Клинический психолог Центра памяти и&nbsp;здоровья Благотворительного центра &laquo;Хэсэд Авраам&raquo;'
      },
      {
        idVideo: '0vWDcZMKrzs',
        img: './img/page/webinards/3.jpg',
        number: '#03',
        title: 'Эрготерапия в&nbsp;работе с&nbsp;людьми с&nbsp;деменцией',
        text: 'О&nbsp;принципах эрготерапии для восстановления утраченных функций пациентов, в&nbsp;том числе с&nbsp;помощью особой организации пространства и&nbsp;быта',
        name: 'Екатерина Анатольевна Мишина',
        autorInfo: 'Врач-невролог, эрготерапевт'
      },
    ]

  +titlePage('Конференции')
  +breadcrumbs([
    { title: 'Главная', url: 'index.html' },
    { title: 'База знаний', url: 'knowledge-base.html' },
    { title: 'Конференции', current: true }
  ])

  main.page.page__webinards
    +heroImage('./img/hero-image/conferences.jpg', 'Родственникам')

    .box 
      .container 
        .text-center--d.text-center--d-110 
            p.pb-d-2.pb-m-1 <b>Благотворительный центр</b> &laquo;<a href="#" class="link__red">Хэсэд Авраам</a>&raquo; <b>с&nbsp;2003 года регулярно выступает организатором крупных отраслевых событий,</b> объединяющих специалистов в&nbsp;сфере заботы о&nbsp;людях с&nbsp;деменцией для обмена методическими разработками и&nbsp;практическим опытом.
            p <b>С 2022 года конференции включены в программу Международного форума «Старшее поколение»,</b> который ежегодно проходит в Санкт-Петербурге при поддержке городского Комитета по социальной политике.

    

