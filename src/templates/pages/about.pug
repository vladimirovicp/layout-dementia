extends ../layouts/_layout.pug

block title
  title О нас

block content

  include ../help/variables.pug

  +titlePage('О нас')
  +breadcrumbs([
    { title: 'Главная', url: 'index.html' },
    { title: 'База знаний', url: 'knowledge-base.html' },
    { title: 'О нас', current: true}
  ])

  main.page.page__about
    +heroImage('./img/hero-image/about.png', 'О нас')

    

    .about__history.pb-b
      .container
        .cards
          .card.card__one
            .box-text
                .text <strong>Поддержка людей с&nbsp;деменцией и&nbsp;их&nbsp;близких</strong>&nbsp;&mdash; одно из&nbsp;приоритетных направлений работы Благотворительного центра &laquo;<a href="#" class="link__red">Хэсэд Авраам&raquo;</a>, который был основан в&nbsp;1993 году организациями еврейской общины Санкт-Петербурга.
                .text Центр ориентирован на&nbsp;оказание помощи людям старшего возраста с&nbsp;ограниченными возможностями здоровья, малообеспеченным и&nbsp;находящимся в&nbsp;трудной жизненной ситуации.

          .card.card__two
            .cards.cards__red.cards__circle-right
              a(href="#" class="card card__link")
                .icon
                  +svgDataCardsRed('32')
                .text Курсы
                .card__circle2 
                  .card__circle2_back
                    +svgDataArrow('topRight')

              a(href="#" class="card card__link")
                .icon
                  +svgDataCardsRed('33')
                .text Стажировки
                .card__circle2 
                  .card__circle2_back
                    +svgDataArrow('topRight')
    
    .about__info-title
      .container
        .sizing-110
          .title-3.text-center Сегодня «Хэсэд Авраам» — одна из крупнейших общественных благотворительных организаций России

    .about__info.pb-b
      .container
        .highlight-background.highlight-background__radius-top
        .cards
          .card
            .number >1000
            .text сотрудников
          .card 
            .number >400
            .text волонтеров
          .card
            .number >10000
            .text подопечных
        
    .about__description
      .highlight-background
      .container
        .sizing-90
          .text Специалистами &laquo;<a href="#" class="link__red">Хэсэд Авраам</a>&raquo; накоплен обширный опыт реализации программ для пожилых людей с&nbsp;когнитивными нарушениями на&nbsp;базе очных площадок, не&nbsp;имеющих аналогов в&nbsp;стране и&nbsp;объединённых в&nbsp;единую экосистему помощи

    .container
      .pair
        .pair__img 
          picture 
            img(src="./img/page/about/1.png", alt="Центр памяти и здоровья")
        .pair__info 
          .pair__title Центр памяти и здоровья
          .pair__text
            p В&nbsp;Центре памяти и&nbsp;здоровья, открытом в&nbsp;2014&nbsp;году, ежедневно проходят занятия для пожилых людей с&nbsp;преддементными нарушениями и&nbsp;деменцией, которые столкнулись с&nbsp;ухудшением памяти и&nbsp;ориентации во&nbsp;времени и&nbsp;пространстве, расстройствами внимания, понимания и&nbsp;речи.
            p Психологи Центра занимаются диагностикой деменции, проводят занятия, направленные на&nbsp;сохранение и&nbsp;восстановление когнитивных способностей (в&nbsp;том числе в&nbsp;формате арт-терапии), а&nbsp;также работают с&nbsp;родственниками подопечных в&nbsp;специальной группе поддержки.


