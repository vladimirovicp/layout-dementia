extends ../layouts/_layout.pug

block title
  title База знаний

block content

  - 
    var dataCards = [
      {      
        'title': 'О нас',
        'numIcon': '24',
        'text': 'Комплексная экосистема помощи людям с&nbsp;деменцией Благотворительного центра &laquo;Хэсэд Авраам&raquo; объединяет Центр памяти и&nbsp;здоровья, Центр дневного ухода &laquo;Лоскутки&raquo;, Пансионат &laquo;Курортный&raquo;, Центр знаний о&nbsp;деменции и&nbsp;Фонд целевого капитала &laquo;Человек Рассеянный&raquo;'
      },
      {      
        'title': 'Обучение',
        'numIcon': '25',
        'text': 'Центр знаний о&nbsp;деменции, созданный для масштабирования модели социального ухода за&nbsp;людьми с&nbsp;деменцией, организует информационные курсы, стажировки и&nbsp;консультации для специалистов со&nbsp;всей России'
      },
      {      
        'title': 'Партнерство',
        'numIcon': '26i',
        'text': '&laquo;Хэсэд Авраам&raquo; развивает разнообразные партнёрские проекты и&nbsp;открыт для сотрудничества с&nbsp;организациями, заинтересованными в&nbsp;построении системной помощи людям с&nbsp;деменцией в&nbsp;России'
      },
      {      
        'title': 'О нас',
        'numIcon': '27i',
        'text': 'С&nbsp;2003 года &laquo;Хэсэд Авраам&raquo; регулярно выступает организатором крупных отраслевых событий, которые объединяют специалистов в&nbsp;сфере заботы о&nbsp;людях с&nbsp;деменцией для обмена актуальным опытом'
      },
            {      
        'title': 'Методические материалы',
        'numIcon': '28',
        'text': 'Центр знаний о&nbsp;деменции создаёт разнообразные методические материалы, которые могут быть полезны специалистам, а&nbsp;также родственникам людей с&nbsp;деменцией'
      },
      {      
        'title': 'Вебинары',
        'numIcon': '29',
        'text': 'При участии партнёров проводятся вебинары, посвящённые ключевым вопросам взаимодействия и&nbsp;работы с&nbsp;людьми с&nbsp;деменцией и&nbsp;адресованные не&nbsp;только специалистам, но&nbsp;и&nbsp;родственникам'
      },
      {      
        'title': 'Наши амбассадоры',
        'numIcon': '30',
        'text': 'Мы&nbsp;развиваем сообщество амбассадоров&nbsp;&mdash; известных людей, которые помогают нам доносить до&nbsp;широкой аудитории наши ценности и&nbsp;фокусировать внимание на&nbsp;проблемах людей с&nbsp;деменцией'
      },

    ]
  .title__page
      .container База знаний

  .breadcrumbs
    .container
      ul.breadcrumbs__list
        li.breadcrumbs__item 
          a(href="index.html" class="breadcrumbs__link link__red") Главная
        li.breadcrumbs__item  
          span.breadcrumbs__current База знаний

  main.page.page__knowledge-base
    .hero-image
      .container
        picture
          img(src='./img/hero-image/knowledge-base.png' alt="База знаний") 

    
    .knowledge-base__box-text 
      .container 
        .wrapper Специалистами Благотворительного центра &laquo;Хэсэд Авраам&raquo; накоплен <strong>обширный опыт реализации программ для пожилых людей с&nbsp;когнитивными нарушениями на&nbsp;базе очных площадок, не&nbsp;имеющих аналогов в&nbsp;стране</strong> и&nbsp;объединённых в&nbsp;комплексную экосистему помощи

    .knowledge-base__box-cards
      .highlight-background.highlight-background__radius-top.highlight-background__radius-bottom
      .container
        .cards.cards__white-circle.cards__white-circle-d2
          each el in dataCards
            a(href="#" class="card card__link")
              .card__header 
                .icon
                  +svgDataCardsRed(el.numIcon)
                .title 
                  != el.title
              .text 
                != el.text
              .card__circle2 
                .card__circle2_back
                  +svgDataArrow('topRight')


          a(href="#" class="card card__link card_wine")
            .card__header 
              .icon
                +svgDataCardsRed("31")
              .title Связаться с нами 
                
            .text Будем рады рассмотреть ваши предложения, касающиеся проведения совместных мероприятий по&nbsp;обмену опытом, организации партнёрских проектов и&nbsp;других форм сотрудничества
            .card__circle2 
              .card__circle2_back
                +svgDataArrow('topRight')


    .popup__feedback-form    
      

